# HELP node_cpu_seconds_total Seconds the cpus spent in each mode.
# TYPE node_cpu_seconds_total counter
node_cpu_seconds_total{cpu="0",mode="idle"} 1000.5
node_cpu_seconds_total{cpu="0",mode="system"} 10.25
node_cpu_seconds_total{cpu="1",mode="idle"} 1001.5
node_cpu_seconds_total{cpu="1",mode="system"} 11.25
node_cpu_seconds_total{cpu="2",mode="idle"} 1002.5
node_cpu_seconds_total{cpu="3",mode="idle"} 1003.5
# HELP node_memory_MemTotal_bytes Total memory.
# TYPE node_memory_MemTotal_bytes gauge
node_memory_MemTotal_bytes 1.6768e+10
# HELP node_load1 Load average over one minute.
# TYPE node_load1 gauge
node_load1 3.14
# HELP node_vmstat_oom_kill oom kills since boot.
# TYPE node_vmstat_oom_kill untyped
node_vmstat_oom_kill 2
# HELP node_disk_read_bytes_total Bytes read from disk.
# TYPE node_disk_read_bytes_total counter
node_disk_read_bytes_total{device="sda"} 5000
node_disk_read_bytes_total{device="sdb"} 6000
# HELP node_pressure_cpu_waiting_seconds_total Stalled time on cpu.
# TYPE node_pressure_cpu_waiting_seconds_total counter
node_pressure_cpu_waiting_seconds_total 12.5
# HELP node_filesystem_avail_bytes Available space.
# TYPE node_filesystem_avail_bytes gauge
node_filesystem_avail_bytes{device="/dev/root",fstype="ext4",mountpoint="/"} 4.2e+10
node_filesystem_avail_bytes{device="/dev/sdb1",fstype="ext4",mountpoint="/mnt"} 9e+09
node_filesystem_avail_bytes{device="odd \" name",fstype="ext4",mountpoint="/data"} 7e+09
# HELP gha_step_active Currently running workflow step.
# TYPE gha_step_active gauge
gha_step_active{step="burn cpu"} 1
